{
  "name": "client-side-architecture",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:container": "ng serve container-app -o",
    "start:mfe2": "ng serve mfe-premium-payment -o",
    "start:mfe1": "ng serve mfe-insurance-details -o",
    "build:container": "ng build container-app --configuration production",
    "build:mfe2": "ng build mfe-premium-payment --configuration production",
    "build:mfe1": "ng build mfe-insurance-details --configuration production",
    "start": "concurrently \"npm run start:container\" \"npm run start:mfe1\" \"npm run start:mfe2\" ",
    "build": "npm run build:container && npm run build:mfe1 && npm run build:mfe2",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.0.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/material": "^18.0.1",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "concurrently": "^9.1.2",
    "ngx-build-plus": "^18.0.0",
    "rxjs": "~7.8.0",
    "shared": "file:dist/shared",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-architects/module-federation": "^19.0.1",
    "@angular-devkit/build-angular": "^18.2.12",
    "@angular/cli": "^18.2.12",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^18.2.0",
    "typescript": "~5.5.2"
  }
}
